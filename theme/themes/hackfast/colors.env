# hackfast — source of truth for every color in these dotfiles.
# Edit colors.env, then run: ~/dotfiles/theme/build.sh
# Format: key=#rrggbb. Roles may reference palette keys with $key.
# Base: GitHub Dark Default, pure black background.

# base
bg=#000000
fg=#f0f6f6
fg_bright=#f0f6fc
fg_dim=#8b949e
border=#484f58
cursor=#f5f5f5
selection_bg=#264f78
selection_fg=#f0f6fc

# ansi 0-7
black=#484f58
red=#ff7b72
green=#3fb950
yellow=#d29922
blue=#58a6ff
magenta=#bc8cff
cyan=#39c5cf
white=#b1bac4

# ansi 8-15
bright_black=#6e7681
bright_red=#ffa198
bright_green=#56d364
bright_yellow=#e3b341
bright_blue=#79c0ff
bright_magenta=#d2a8ff
bright_cyan=#56d4dd
bright_white=#ffffff

# extras
orange=#ffa657
light_blue=#a5d6ff
light_green=#7ee787

# roles: files (lsd, LS_COLORS, yazi, neo-tree)
dir=$blue
exec=$green
symlink=$cyan
orphan=$red
image=$yellow
media=$magenta
archive=$red
document=$cyan
file=$fg

# file groups (extensions colored by the roles above)
ext_image='png jpg jpeg gif webp svg bmp ico heic tiff'
ext_media='mp3 flac wav ogg m4a aac mp4 mkv mov avi webm'
ext_archive='zip tar gz tgz xz zst bz2 7z rar dmg iso'
ext_document='pdf doc docx rtf epub odt'

# roles: syntax (nvim)
syn_keyword=$red
syn_string=$light_blue
syn_func=$bright_magenta
syn_const=$bright_blue
syn_type=$orange
syn_tag=$light_green
syn_comment=$fg_dim
syn_ident=$fg

# icons (Nerd Font glyphs, shared by neo-tree, lsd, yazi)
icon_dir=''
icon_dir_open=''
icon_dir_empty='󰜌'
