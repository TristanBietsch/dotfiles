# generated by theme/build.sh ({{theme}}). Edit theme/themes/{{theme}}/colors.env instead.
# Read by lsd (file/dir names) and zsh completion menus.
_c() { printf '38;2;%s' "$1"; }
_img='{{ext_image}}'
_media='{{ext_media}}'
_arc='{{ext_archive}}'
_doc='{{ext_document}}'

LS_COLORS="di=1;$(_c '{{dir.rgb}}'):ex=$(_c '{{exec.rgb}}'):ln=3;$(_c '{{symlink.rgb}}')"
LS_COLORS+=":or=$(_c '{{orphan.rgb}}'):mi=$(_c '{{orphan.rgb}}'):fi=$(_c '{{file.rgb}}')"
LS_COLORS+=":pi=$(_c '{{yellow.rgb}}'):so=$(_c '{{magenta.rgb}}'):bd=$(_c '{{yellow.rgb}}'):cd=$(_c '{{yellow.rgb}}')"
for e in ${=_img};   do LS_COLORS+=":*.$e=$(_c '{{image.rgb}}')"; done
for e in ${=_media}; do LS_COLORS+=":*.$e=$(_c '{{media.rgb}}')"; done
for e in ${=_arc};   do LS_COLORS+=":*.$e=$(_c '{{archive.rgb}}')"; done
for e in ${=_doc};   do LS_COLORS+=":*.$e=$(_c '{{document.rgb}}')"; done
export LS_COLORS
unset -f _c; unset _img _media _arc _doc e

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
