# macOS noise
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# macOS folder attributes
Icon?
._*

# Thumbnails
._.Thumbs.db
Thumbs.db

# Stow safety
stow-local-ignore
stow-global-ignore

# Logs / temp
*.log
*.tmp
*~

# Swap files (Neovim/Vim)
*.swp
*.swo
*.swm

# Backup files
*.bak
*.orig

# ncspot state
ncspot/.config/ncspot/userstate.cbor
ncspot/.config/ncspot/*.bak*

# Node projects inside dotfiles (if present)
node_modules/

# Python environments (if present)
__pycache__/
*.pyc
.env
.venv

# Cargo (if present)
target/

# VSCode/JetBrains configs (if accidentally created)
.vscode/
.idea/

# Obsidian local junk
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache/
obsidian/.obsidian/plugins/*/main.js
obsidian/.obsidian/plugins/*/styles.css
obsidian/.obsidian/plugins/*/lib3/

# Git-related tools
gh/

# SSH/GPG private keys (critical if you're symlinking .ssh)
*.pem
id_*
!id_*.pub

# Secrets that might sneak in
.env.local
*.secret
*_secret*

# System files
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msixbundle
*.lnk
Thumbs.db

# Karabiner auto backups (written into the linked config dir)
karabiner/.config/karabiner/automatic_backups/

# Work-specific Claude skills: kept local, never pushed (public repo)
claude/.claude/skills/ob/
claude/.claude/skills/pres/
claude/.claude/skills/prmsg/
claude/.claude/skills/rmsg/

# ---- Sensitive: never commit (defense in depth) ----
# Private keys / certs / keystores
*.key
*.p12
*.pfx
*.jks
*.keystore
*.gpg
*.asc
*.age
*.kdbx
id_rsa*
id_ecdsa*
id_ed25519*
!*.pub
.ssh/
.gnupg/

# Env / credential files
.env
.env.*
!.env.example
*.env
.envrc
.netrc
.npmrc
.pypirc
.pgpass
.git-credentials
credentials
credentials.json
*credentials*.json
*-credentials*
service-account*.json
token.json
*.token
*_token*
secrets.*
*.secrets
.secrets/

# Tool auth/state dirs
.aws/
.config/gh/hosts.yml
.config/op/
.op/
.docker/config.json
.kube/
.terraform/
*.tfstate
*.tfstate.*
.vault-token

# Solana keypairs
*keypair*.json
.config/solana/id.json

# Shell history
.*_history
.zsh_history
.bash_history

# Timestamped backups (e.g. .zshrc.bak.123)
*.bak.*
!theme/themes/**/colors.env
