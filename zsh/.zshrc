PROMPT='%n@%m %~ ∴ '
# PROMPT='%n@%m %~ λ '

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"
export PATH="$PATH:$HOME/go/bin"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.opencode/bin:$PATH"
export PATH="$PATH:$HOME/.lmstudio/bin"
export FZF_DEFAULT_OPTS_FILE="$HOME/.fzfrc"

# colors: generated by theme/build.sh
[ -f "$HOME/.config/zsh/ls_colors.zsh" ] && source "$HOME/.config/zsh/ls_colors.zsh"

# aliases
alias ls='lsd --tree --depth 1'
alias ll='lsd -la'
alias la='lsd -a'
alias lt='lsd --tree'
alias c='clear'
alias browse='w3md'
alias files='y'
alias pn='pnpm'
alias cc='claude --dangerously-skip-permissions'
alias aa='antigravity --dangerously-skip-permissions'
alias agy='agy --dangerously-skip-permissions'
alias antigravity='antigravity --dangerously-skip-permissions'
alias ai='ollama run qwen3:30b-a3b'
alias bottom='btm'
alias tvm='ssh -4 -p 2222 -i ~/.ssh/beos_local -o IdentitiesOnly=yes tristan@127.0.0.1'

# tool integrations
# envman
[ -s "$HOME/.config/envman/load.sh" ] && source "$HOME/.config/envman/load.sh"

# os-specific: zsh/.config/zsh/os/<os>.zsh
case "$OSTYPE" in
    darwin*) _os=darwin ;;
    linux*) _os=linux ;;
    freebsd*) _os=freebsd ;;
    *) _os= ;;
esac
[ -n "$_os" ] && [ -f "$HOME/.config/zsh/os/$_os.zsh" ] && source "$HOME/.config/zsh/os/$_os.zsh"
unset _os

# nvm
[ -s "$HOME/.nvm/nvm.sh" ] && . "$HOME/.nvm/nvm.sh"

# secrets
[ -f "$HOME/.secrets" ] && source "$HOME/.secrets"

[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

# Added by Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
alias df-save='$HOME/dotfiles/scripts/df-save'
export PATH="$PATH:$HOME/go/bin"
export AGENC_RUNNER_DIR=$HOME/Documents/pediment/agenc-cli/runner-ts

alias job="$HOME/Documents/personal/job-search/career-ops/dashboard/career-dashboard --path $HOME/Documents/personal/job-search/career-ops"

# BEGIN REX
export PATH="$HOME/.local/bin:$PATH"
autoload -Uz compinit && compinit -i
source <(rex completion zsh 2>/dev/null) || true
# END REX


# yazi: cd into last dir on quit.
y() {
	local tmp="$(mktemp -t yazi-cwd.XXXXXX)" cwd
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		builtin cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
export PATH="$HOME/.local/share/solana/install/active_release/bin:$PATH"


# Added by Antigravity CLI installer
export PATH="$HOME/.local/bin:$PATH"

# BEGIN opam configuration
# This is useful if you're using opam as it adds:
#   - the correct directories to the PATH
#   - auto-completion for the opam binary
# This section can be safely removed at any time if needed.
[[ ! -r "$HOME/.opam/opam-init/init.zsh" ]] || source "$HOME/.opam/opam-init/init.zsh" > /dev/null 2> /dev/null; true
# END opam configuration

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
fpath=(~/.grok/completions/zsh $fpath)
autoload -Uz compinit && compinit -C
# <<< grok installer <<<
