# generated by theme/build.sh (hackfast). Edit theme/themes/hackfast/colors.env instead.
# Read by lsd (file/dir names) and zsh completion menus.
_c() { printf '38;2;%s' "$1"; }
_img='png jpg jpeg gif webp svg bmp ico heic tiff'
_media='mp3 flac wav ogg m4a aac mp4 mkv mov avi webm'
_arc='zip tar gz tgz xz zst bz2 7z rar dmg iso'
_doc='pdf doc docx rtf epub odt'

LS_COLORS="di=1;$(_c '88;166;255'):ex=$(_c '63;185;80'):ln=3;$(_c '57;197;207')"
LS_COLORS+=":or=$(_c '255;123;114'):mi=$(_c '255;123;114'):fi=$(_c '240;246;246')"
LS_COLORS+=":pi=$(_c '210;153;34'):so=$(_c '188;140;255'):bd=$(_c '210;153;34'):cd=$(_c '210;153;34')"
for e in ${=_img};   do LS_COLORS+=":*.$e=$(_c '210;153;34')"; done
for e in ${=_media}; do LS_COLORS+=":*.$e=$(_c '188;140;255')"; done
for e in ${=_arc};   do LS_COLORS+=":*.$e=$(_c '255;123;114')"; done
for e in ${=_doc};   do LS_COLORS+=":*.$e=$(_c '57;197;207')"; done
export LS_COLORS
unset -f _c; unset _img _media _arc _doc e

zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
