[user]
    name = Tristan Bietsch
    email = tb.co@icloud.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKuS1ft43FQWm4TssIGLlRe6taSscOgcd0riftOo48yn

[init]
	defaultBranch = master

[core]
    editor = nvim
    pager = less

[alias]
    s = status -sb
    co = checkout
    br = branch
    lg = log --oneline --graph --all --decorate

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[gpg]
    format = ssh

[gpg "ssh"]
    program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
    allowedSignersFile = ~/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true
